# ==========================================
# GOOGLE ANALYTICS 4 (GA4)
# ==========================================
# GA4 Measurement ID for tracking
# Get from: Google Analytics > Admin > Data Streams > Web > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==========================================
# AUTOMATED BLOG GENERATION - API KEYS
# ==========================================
# IMPORTANT: Never commit .env.local to git!

# Anthropic Claude API (for content generation)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key-here

# Google Gemini API (for image generation)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Unsplash Access Key (optional fallback for images)
# Get your key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-key-here

# Auto-commit setting (set to false for safety - manual review required)
AUTO_COMMIT=false

# ==========================================
# ZAPIER WEBHOOKS
# ==========================================
# Partner inquiry webhook (used by /api/partners/inquiry)
ZAPIER_PARTNER_INQUIRY_WEBHOOK_URL=your-zapier-webhook-url-here

# Fallback webhook URL for general use
ZAPIER_WEBHOOK_URL=your-zapier-webhook-url-here

# Client-side accessible webhook URL (for corporate page form)
# REQUIRED: Must have NEXT_PUBLIC_ prefix to be accessible in browser
NEXT_PUBLIC_ZAPIER_PARTNER_WEBHOOK_URL=your-zapier-webhook-url-here

# ==========================================
# SHOPIFY CONFIGURATION
# ==========================================
# Storefront API (public)
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token

# Admin API (server-side only)
SHOPIFY_ADMIN_ACCESS_TOKEN=your-admin-token
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# ==========================================
# DATABASE (VERCEL POSTGRES)
# ==========================================
POSTGRES_URL=your-postgres-connection-string
POSTGRES_URL_NON_POOLING=your-postgres-direct-url

# ==========================================
# STRIPE (PAYMENTS)
# ==========================================
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# ==========================================
# ADMIN API
# ==========================================
# Secure key for admin sync endpoints
ADMIN_API_KEY=your-secure-admin-api-key

# ==========================================
# AUTHENTICATION
# ==========================================
# Secret for JWT session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# ==========================================
# AI SERVICES (CLAUDE)
# ==========================================
# For AI-powered inventory features
OPENROUTER_API_KEY=your-openrouter-key

# ==========================================
# VERCEL LOG DRAIN
# ==========================================
# Signature verification secret for the log drain feeding /api/webhooks/vercel-drain
# (server-side traffic + bot detection -> vercel_events).
# Get from: Vercel Dashboard > Team Settings > Log Drains > (drain) > Secret
# Must match the drain's secret exactly. In production an unset secret does NOT
# disable verification — the endpoint rejects every delivery instead of storing
# unauthenticated data. Changing it requires a redeploy to take effect.
VERCEL_DRAIN_SECRET=your-vercel-drain-secret

# ==========================================
# APP URL
# ==========================================
# Public base URL used in emails, checkout redirects, share links.
NEXT_PUBLIC_APP_URL=https://partyondelivery.com
# Alt name used by legacy group-orders v1 code paths
NEXT_PUBLIC_BASE_URL=https://partyondelivery.com

# ==========================================
# CRON JOBS
# ==========================================
# Bearer token required by /api/cron/* endpoints (generate-blog, reconcile-orders, affiliate-*, group-orders-v2)
CRON_SECRET=your-cron-secret

# ==========================================
# EMAIL (RESEND)
# ==========================================
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=orders@partyondelivery.com
# Signing secret for /api/webhooks/resend delivery/bounce events
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret
# ZeroBounce email verification for partner-outreach prospects (pay-as-you-go).
# Unset = verification unavailable (routes return 501, sends stay gated).
ZEROBOUNCE_API_KEY=your-zerobounce-key

# ==========================================
# SMS / CRM (GOHIGHLEVEL)
# ==========================================
# Order confirmations/SMS webhook
GHL_ORDER_WEBHOOK_URL=your-ghl-order-webhook
# Post-delivery review request webhook
GHL_REVIEW_WEBHOOK_URL=your-ghl-review-webhook
# Dashboard-share SMS webhook
GHL_DASHBOARD_WEBHOOK_URL=your-ghl-dashboard-webhook
# Used by /api/v2/group-orders/[code]/send-link
GHL_WEBHOOK_URL=your-ghl-webhook

# ==========================================
# CORELINQ CRM (GHL replacement — ADR-0007)
# ==========================================
# Fan-out target for store events during the GHL -> CoreLinq migration.
# Full ingest URL INCLUDING the token, e.g.
# https://<crm-domain>/api/ingest/partyon?token=<long-random>
# Unset = fan-out off (GHL-only behavior).
CORELINQ_INGEST_URL=
# Bearer key for the read-only GET /api/v1/crm/lookup API (consumed by the
# CRM's Retell voice-agent tool). Unset = route returns 503. Generate with:
# openssl rand -hex 32   — rotate periodically.
CRM_API_KEY=

# ==========================================
# META / FACEBOOK PIXEL
# ==========================================
# Falls back to a baked-in ID if unset — set this to override.
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id

# ==========================================
# MICROSOFT CLARITY
# ==========================================
# Project ID from https://clarity.microsoft.com (the value after clarity.ms/tag/<id>).
# Initialized client-side by src/components/ClarityInit.tsx in production only.
NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id

# ==========================================
# SUPABASE (product image storage)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# VERCEL BLOB
# ==========================================
# Read/write token for uploads (product images, PDFs)
BLOB_READ_WRITE_TOKEN=your-blob-token

# ==========================================
# GOOGLE — ANALYTICS 4 DATA API & SEARCH CONSOLE
# ==========================================
GOOGLE_GA4_PROPERTY_ID=your-ga4-property-id
GA4_PROPERTY_ID=your-ga4-property-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=your-google-private-key
GOOGLE_SEARCH_CONSOLE_SITE=sc-domain:partyondelivery.com
# JSON blob fallback used by ga4-behavior
GOOGLE_APPLICATION_CREDENTIALS_JSON=your-google-credentials-json

# Inbound email → Lead Flow board (docs/inbound-email-setup.md). Polls this
# mailbox's Gmail INBOX via a service account with domain-wide delegation.
GMAIL_INBOUND_ADDRESS=info@partyondelivery.com
# STRONGLY RECOMMENDED: a DEDICATED service account for Gmail (distinct from the
# analytics GOOGLE_* one), so granting it domain-wide gmail.readonly doesn't
# widen the analytics key to "read any mailbox in the domain". Falls back to
# GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_PRIVATE_KEY when these are unset.
GMAIL_SERVICE_ACCOUNT_EMAIL=your-gmail-service-account@project.iam.gserviceaccount.com
GMAIL_PRIVATE_KEY=your-gmail-service-account-private-key

# ==========================================
# GOOGLE CALENDAR (ops scheduling)
# ==========================================
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=your-calendar-service-account
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=your-calendar-private-key
GOOGLE_CALENDAR_ID=your-calendar-id

# ==========================================
# ADMIN / EMPLOYEE LOGIN
# ==========================================
ADMIN_PASSWORD=your-admin-password
EMPLOYEE_PASSWORD=your-employee-password

# ==========================================
# AUTH — SESSION SECRET ALIAS
# ==========================================
# Fallback used when JWT_SECRET is unset
NEXTAUTH_SECRET=your-nextauth-secret

# ==========================================
# MCP (Model Context Protocol) — ops AI tooling
# ==========================================
MCP_AUTH_TOKEN_READ=your-mcp-read-token
MCP_AUTH_TOKEN_WRITE=your-mcp-write-token
# Optional previous-token values for rotation
MCP_AUTH_TOKEN_READ_PREV=
MCP_AUTH_TOKEN_WRITE_PREV=

# ==========================================
# PREMIER BOAT — GOOGLE SHEET IMPORT
# ==========================================
PREMIER_SCHEDULE_PUBLIC_KEY=your-schedule-public-key
PREMIER_SHEET_SERVICE_ACCOUNT_EMAIL=your-sheet-service-account
PREMIER_SHEET_SERVICE_ACCOUNT_KEY=your-sheet-private-key
PREMIER_SHEET_ID=your-sheet-id
# Used by /api/ops/boat-schedule/sync
BOAT_SCHEDULE_SYNC_KEY=your-sync-key

# ==========================================
# PREMIERE CREDIT AUTOMATION — POD CREDITS SHEET
# ==========================================
# Reuses PREMIER_SHEET_SERVICE_ACCOUNT_EMAIL / _KEY above (share the masterlist
# with that service account as VIEWER — access is read-only by design).
# The 2026 Booking Masterlist spreadsheet id + the credits tab name.
PREMIERE_CREDITS_SHEET_ID=your-masterlist-sheet-id
PREMIERE_CREDITS_SHEET_TAB=POD Credits
# GHL inbound webhook that drives the "Premiere Credit — SMS" workflow.
# Leave unset until the workflow exists — SMS is a no-op without it.
GHL_PREMIERE_CREDIT_WEBHOOK_URL=
# Where the per-tick "codes issued" summary goes so Premiere can update the
# sheet's POD Code column. Comma-separate to notify more than one person
# (first address = To, the rest = Cc), e.g. grey@premierpartycruises.com,va@premierpartycruises.com
PREMIERE_PARTNER_NOTIFY_EMAIL=

# ==========================================
# ZAPIER — CONTACT FORM
# ==========================================
ZAPIER_CONTACT_WEBHOOK_URL=your-contact-webhook-url

# ==========================================
# VERCEL KV (optional cache)
# ==========================================
KV_URL=your-kv-url

# ==========================================
# ALTERNATE SHOPIFY ADMIN TOKEN NAME
# ==========================================
# Some code paths still read the older var name — set this OR SHOPIFY_ADMIN_ACCESS_TOKEN above
SHOPIFY_ADMIN_API_TOKEN=your-admin-token

# ==========================================
# FINANCE DIRECTOR — QuickBooks Online (Phase 0+)
# ==========================================
# Create app at https://developer.intuit.com. Start in sandbox; move to
# production after Phase 0 PR merges and the operator promotes manually.
INTUIT_CLIENT_ID=your-intuit-client-id
INTUIT_CLIENT_SECRET=your-intuit-client-secret
INTUIT_ENV=sandbox
INTUIT_REDIRECT_URI=https://partyondelivery.com/api/admin/finance/qb/callback

# ==========================================
# FINANCE DIRECTOR — Plaid (Phase 0+)
# ==========================================
# Sandbox creds work with Plaid's `user_good` / `pass_good` fake institution.
# PLAID_ENV: sandbox | development | production
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# --- Google Ads conversion tracking (Phase C) ---
# Set these once the operator builds conversion actions in the Google Ads UI.
# Leave empty in dev — conversion firing is a no-op until populated.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GADS_QUOTE_CONVERSION_ID=
NEXT_PUBLIC_GADS_PURCHASE_CONVERSION_ID=

# --- Follow-up email system (src/lib/followups) ---
# HMAC secret for unsubscribe tokens — the engine refuses to run without it.
# Generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=
# Personal from-address for follow-up emails (journeys send as
# "Allan at Party On Delivery <info@partyondelivery.com>").
FOLLOWUP_FROM_EMAIL=info@partyondelivery.com
FOLLOWUP_FROM_NAME=

# Set to 1 to make Full Moon Party ticket sales live (Stripe). Unset/anything-else = off.
FULL_MOON_TICKETS_LIVE=
# Optional operator hide-list for the public guest list: comma-separated EXACT
# buyer names (case-insensitive) to suppress, e.g. "Some Name, Another Name".
FULL_MOON_GUEST_HIDE=
