# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# macOS system files
__MACOSX/

# Windows WSL metadata
*:Zone.Identifier

# image generator tool (contains API keys)
image-generator-tool/

# tool output directories
.firecrawl/
.playwright-mcp/

# communication-playbook corpus exports (customer PII — never commit)
data/comms-corpus/

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
.env*.local
.claude/scheduled_tasks.lock
.claude/worktrees/
obsidian-vault

# MCP config — contains env-var interpolation that resolves to live secrets at runtime.
# Commit .mcp.example.json instead; teammates copy to .mcp.json locally.
.mcp.json

# generated ops artifacts (regenerated by scripts/ops/* on each run)
/weekly-summary.html
/purchase-plan.html
/order-list.html
/boat-callsheet.html
